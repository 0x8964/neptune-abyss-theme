    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "comment.block.documentation"
            ],
            "settings": {
                "foreground": "#6B7280",
                "fontStyle": ""
            }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.regexp"
            ],
            "settings": {
                "foreground": "#9CDCFE",
                "fontStyle": ""
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.character",
                "constant.language.boolean",
                "constant.language"
            ],
            "settings": {
                "foreground": "#79C0FF",
                "fontStyle": ""
